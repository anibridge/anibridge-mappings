{
  "name": "anibridge-mappings",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "25" },
    "ghcr.io/devcontainers-extra/features/apt-packages:1": {
      "packages": "ripgrep,sqlite3"
    },
    "ghcr.io/devcontainers-extra/features/uv:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "astral-sh.ty",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "redhat.vscode-yaml",
        "SmallMain.vscode-unify-chat-provider",
        "tamasfe.even-better-toml",
        "yzhang.markdown-all-in-one"
      ],
      "settings": { "python-envs.terminal.autoActivationType": "shellStartup" }
    }
  },
  "postCreateCommand": "uv sync --all-extras --all-groups --all-packages ; (cd app && pnpm i)",
  "containerEnv": { "UV_LINK_MODE": "copy" }
}
